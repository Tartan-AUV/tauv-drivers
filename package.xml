<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tauv_drivers</name>
  <version>0.0.0</version>
  <description>Core sensor and actuator drivers for Tartan-AUV.</description>
  <maintainer email="aayan@cmu.edu">Aayan Maheshwari</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tauv_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavros_msgs</depend>


  <exec_depend>python3-adafruit-circuitpython-servokit</exec_depend>
  <exec_depend>python3-adafruit-circuitpython-extended-bus</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-smbus</exec_depend>
  <exec_depend>python3-dronecan</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>