<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tauv_dronecan</name>
  <version>0.1.0</version>
  <description>DroneCAN driver for Tartan-AUV thrusters using the DroneCAN Python stack.</description>
  <maintainer email="aayan@cmu.edu">Aayan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tauv_msgs</exec_depend>
  <exec_depend>python3-dronecan</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>